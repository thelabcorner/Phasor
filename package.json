{
  "name": "waapi-to-svg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Conformance-driven standalone WAAPI to animated SVG compiler",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/capture.d.ts",
      "default": "./dist/browser/capture.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:chromium": "npm run build && node tools/chromium-differential.mjs && node tools/chromium-seeded-differential-v2.mjs",
    "test:image": "npm run build && node tools/svg-image-playback.mjs",
    "test:capture": "npm run build && node tools/chromium-native-capture.mjs && node tools/chromium-capture-refusals.mjs",
    "example": "npm run build && node examples/build-circle.mjs",
    "bench": "npm run build && node tools/benchmark.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
